# Get this from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs of bootstrap super admins
# These always have full access regardless of data/admins.json
ADMIN_IDS=123456789,987654321

# Automatically kick users who end up as members without going through
# the paid join-request flow (e.g. added manually, or joined via the
# channel's own primary invite link). true / false
AUTO_KICK_UNPAID=true
